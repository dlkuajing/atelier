# Lumira Atelier Backend — environment variables.
# Copy to .env and fill in. .env is gitignored.

# === LLM routing ===
# Option A: call vendors directly (cross-border latency from CN unstable)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# Option B (preferred): LiteLLM proxy on HK VPS — unifies routing + fallback
LITELLM_BASE_URL=https://your-hk-vps.example/v1
LITELLM_API_KEY=

# === ByteDance Volcengine (Seedance 2.0 Pro video) ===
VOLCENGINE_AK=
VOLCENGINE_SK=

# === Cloudflare AI Gateway ===
CF_ACCOUNT_ID=
CF_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<account>/lumira-atelier
CF_AI_GATEWAY_TOKEN=

# === Espacenet OPS (patent crawler) ===
EPO_OPS_KEY=
EPO_OPS_SECRET=

# === Database (pgvector) ===
DATABASE_URL=postgresql+psycopg://lumira:password@localhost:5432/lumira

# === Observability ===
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# === App ===
ENV=local
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://lumirahq.com
