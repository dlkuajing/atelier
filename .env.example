# Lumira Atelier Backend — environment variables.
# Copy to .env and fill in. .env is gitignored.
#
# All LLM / image calls go through ONE OpenAI-compatible relay station
# (replaces v1.1's LiteLLM HK VPS plan + per-vendor key申请).
# Owner-provided endpoint: see /OWNER-CHECKLIST.md §relay.

# === Relay station (REQUIRED) ===
OPENAI_BASE_URL=https://api.openbili.com/v1
OPENAI_API_KEY=sk-relay-replace-with-real-key

# === Database (pgvector) — wave 2 ===
DATABASE_URL=postgresql+psycopg://lumira:password@localhost:5432/lumira

# === Espacenet OPS (patent crawler real ingestion) — wave 2 ===
EPO_OPS_KEY=
EPO_OPS_SECRET=

# === Cloudflare AI Gateway — wave 2 (optional caching layer) ===
CF_ACCOUNT_ID=
CF_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<account>/lumira-atelier
CF_AI_GATEWAY_TOKEN=

# === Observability — wave 2 (Langfuse self-hosted or Cloud) ===
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# === App ===
ENV=local
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://lumirahq.com
