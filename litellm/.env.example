# LiteLLM proxy env — placed at /etc/litellm/.env on the HK VPS or alongside
# docker-compose.yml. Gitignored.

# Master key for the proxy itself — clients send this as `Authorization: Bearer ...`
LITELLM_MASTER_KEY=sk-litellm-replace-with-random-32-chars

# Vendor keys — LiteLLM forwards calls using these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
