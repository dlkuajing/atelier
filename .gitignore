__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
.env
.env.*
!.env.example
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.DS_Store
# Crawled patents (large, not committed; produced by scripts/patent_crawler.py).
# Leading-slash + /* scopes this to the backend-root data/ dir only, so the
# version-controlled real-design ammo (data/zmx) stays tracked, and tests/data /
# app/data (different paths) are unaffected.
/data/*
!/data/zmx/
!/data/demo_cache/
!/data/demo_cache/**
!/data/patents/
/data/patents/*
!/data/patents/uspto-smartphone-batch*.jsonl
!/data/patent-ledger/
!/data/patent-ledger/**
*.db
*.sqlite

# loop/codex 运行时临时目录（曾误入 commit，2026-07-04 清除）
.tmp/
.verify-tmp/
# CODE V 跑批的 work dir 不能带点前缀组件（否则 ZEMAXOS_TO_CV 静默导入哑元系统），
# 所以 demo cache 的运行目录必须用无点名字，单列一条 ignore。
tmp-demo-cache-codev/
scratch_probe/
scratch_experiment/
scratch_diag/
var/
