! P13 glass snap chain; NEW glass assignment/freeze grammar pending real-machine verification.
FCT @p13wfe(NUM ^dummy)
LCL NUM ^dummy ^f ^ok ^rwe(10,26) ^value ^max
^max == 0
^ok == RMSWE(1,0,60,^rwe,'NOM')
IF ^ok >= 0
  FOR ^f 1 (NUM F)
    ^value == ABSF(^rwe(1,^f))
    IF ^value > ^max
      ^max == ^value
    END IF
  END FOR
END IF
END FCT ^max
FCT @p13wfeok(NUM ^dummy)
LCL NUM ^dummy ^ok ^rwe(10,26)
^ok == RMSWE(1,0,60,^rwe,'NOM')
END FCT ^ok
OUT NO
IN CV_MACRO:ZEMAXOS_TO_CV "C:\Users\Administrator\AppData\Local\Temp\claude\D--atelier\35264aa5-1da3-4d09-9e86-cf204e30310a\scratchpad\p13matrix-real\out-v7\0000-US20170003482A1_target3_797_optimized-323ccb3f-0e463b0455bb\source.zmx"
