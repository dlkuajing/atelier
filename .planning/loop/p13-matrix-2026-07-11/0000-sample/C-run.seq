^after_snap_frozen_rmswfe_ok == @p13wfeok(1)
! per-field/per-wavelength RMS spot, chromatic detail: pending real-machine macro verification
! GLC intentionally absent: glass remains frozen
FOR ^s 1 (NUM S)
  IF (TYP SUR S^s) = "ASP"
    AC S^s 0
    BC S^s 0
    CC S^s 0
    DC S^s 0
    EC S^s 0
    FC S^s 0
    GC S^s 0
  END IF
END FOR
AUT
  SUR N
  CHG SA
  MXC 5
  MNC 1
  IMP 0.001
GO
