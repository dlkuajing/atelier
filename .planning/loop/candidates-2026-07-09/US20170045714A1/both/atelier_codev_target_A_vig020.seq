FOR ^f 1 ^numfld
  ^field_prefix == "field."
  ^field_prefix == CONCAT(^field_prefix, NUM_TO_STR(^f))
  ^field_x == 0
  ^field_y == 0
  IF ^field_type = "OBJ"
    ^field_x == (XOB F^f Z1)
    ^field_y == (YOB F^f Z1)
  ELS IF ^field_type = "IMG"
    ^field_x == (XIM F^f Z1)
    ^field_y == (YIM F^f Z1)
  ELS IF ^field_type = "ANG"
    ^field_x == (XAN F^f Z1)
    ^field_y == (YAN F^f Z1)
  ELS
    ^field_x == (XRI F^f Z1)
    ^field_y == (YRI F^f Z1)
  END IF
  ^key == CONCAT(^field_prefix, ".definition_type")
  BUF PUT B1 I^row J1 ^key
  BUF PUT B1 I^row J2 ^field_type
  ^row == ^row+1
  ^key == CONCAT(^field_prefix, ".x")
  BUF PUT B1 I^row J1 ^key
  BUF PUT B1 I^row J2 ^field_x
  ^row == ^row+1
