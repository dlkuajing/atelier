FOR ^w 1 ^numwav
  ^wavelength_prefix == "wavelength."
  ^wavelength_prefix == CONCAT(^wavelength_prefix, NUM_TO_STR(^w))
  ^key == CONCAT(^wavelength_prefix, ".wavelength_nm")
  BUF PUT B1 I^row J1 ^key
