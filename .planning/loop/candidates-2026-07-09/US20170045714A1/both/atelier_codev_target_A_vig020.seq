BUF PUT B1 I^row J2 ^maximh
^row == ^row+1
FOR ^s 1 ^numsur
  ^surface_prefix == "surface."
  ^surface_prefix == CONCAT(^surface_prefix, NUM_TO_STR(^s))
  ^surf_type == (TYP SUR S^s)
  ^glass == (GLA S^s)
  ^nd == ABSF((IND S^s W^refw))
  ^vd == 0
  IF (NUM W) >= 3
    ^n1 == ABSF((IND S^s W1))
    ^nl == ABSF((IND S^s WL))
    ^diffn == ^nl - ^n1
    IF ABSF(^diffn) > 1.0E-12
      ^vd == (^nd - 1) / ^diffn
    END IF
  END IF
  ^isstop == 0
  IF ^s = ^stop
    ^isstop == 1
  END IF
  ^coefK == 0
  ^coefA == 0
  ^coefB == 0
  ^coefC == 0
  ^coefD == 0
  ^coefE == 0
  ^coefF == 0
  ^coefG == 0
  ^coefH == 0
  ^coefJ == 0
