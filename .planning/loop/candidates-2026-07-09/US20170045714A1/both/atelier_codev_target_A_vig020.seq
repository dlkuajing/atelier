  ^key == CONCAT(^surface_prefix, ".thickness_mm")
  BUF PUT B1 I^row J1 ^key
  BUF PUT B1 I^row J2 (THI S^s)
  ^row == ^row+1
  ^semi_diameter_mm == ABSF((MAP S^s))
  IF ^semi_diameter_mm < 1e-06
    ^semi_diameter_mm == 1e-06
  END IF
  ^key == CONCAT(^surface_prefix, ".semi_diameter_mm")
  BUF PUT B1 I^row J1 ^key
