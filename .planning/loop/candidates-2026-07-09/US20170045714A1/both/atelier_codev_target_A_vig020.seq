^maximh == 0
^pi == 4*ATANF(1)
^deg_to_rad == ^pi/180
^efy == ABSF((EFY))
FOR ^f 1 ^numfld
  ^yh == (YRI F^f Z1)
  IF ^field_type = "ANG"
    ^field_angle_y == (YAN F^f Z1)
    ^field_angle_y_rad == ^field_angle_y * ^deg_to_rad
    ^yh == ^efy * TANF(^field_angle_y_rad)
  ELS IF ^field_type = "IMG"
    ^yh == (YIM F^f Z1)
  END IF
  IF ABSF(^yh) > ^maximh
    ^maximh == ABSF(^yh)
  END IF
