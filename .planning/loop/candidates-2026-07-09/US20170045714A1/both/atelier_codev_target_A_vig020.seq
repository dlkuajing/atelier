    ^coefK == (K S^s)
    ^coefA == (A S^s)
    ^coefB == (B S^s)
    ^coefC == (C S^s)
    ^coefD == (D S^s)
    ^coefE == (E S^s)
    ^coefF == (F S^s)
    ^coefG == (G S^s)
    ^coefH == (H S^s)
    ^coefJ == (J S^s)
  ELS IF ^surf_type = "CON"
    ^coefK == (K S^s)
  END IF
  ^key == CONCAT(^surface_prefix, ".radius_y_mm")
